      "entry": "POST /levelreplay/api/evaluate 的 outputs.head",
      "steps": [
        "门动作与对应闸外水位共同决定证据",
        "上门开 的 状态 为 \"over\""
      ],
      "success": "上门开 的 状态 为 \"over\"",
      "failure": "非法领域数据返回 400；不产生伪造结果",
