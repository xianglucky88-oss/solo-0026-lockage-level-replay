    {
      "id": "compare",
      "name": "循环差分",
      "entry": "POST /levelreplay/api/compare",
      "steps": [
        "时标稳定但可证容积域可能变化",
        "异版产生差异，同版无差异，跨对象拒绝"
      ],
      "success": "异版产生差异，同版无差异，跨对象拒绝",
      "failure": "跨对象比对返回 409",
      "verification": "python3 -m levelreplay.check_flow compare",
