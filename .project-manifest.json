{
  "project_name": "solo-0026-lockage-level-replay",
  "project_shape": "fullstack",
  "modules": [
    {
      "id": "contract",
      "path": "levelreplay/contract.py",
      "responsibility": "JSON 与领域字段边界"
    },
    {
      "id": "domain",
      "path": "levelreplay/domain.py",
      "responsibility": "解析领域单位与归约事实"
    },
    {
      "id": "rules",
      "path": "levelreplay/rules.py",
      "responsibility": "消费归约证据和约束，产生业务判定"
    },
    {
      "id": "artifacts",
      "path": "levelreplay/artifacts.py",
      "responsibility": "成果规范编码、摘要与差分"
    },
    {
      "id": "archive",
      "path": "levelreplay/archive.py",
      "responsibility": "SQLite 历史版本与原子封存"
    },
    {
      "id": "service",
      "path": "levelreplay/service.py",
      "responsibility": "串联归约、比对和历史读取"
    },
    {
      "id": "server",
      "path": "levelreplay/server.py",
      "responsibility": "本机 HTTP 及静态界面入口"
    },
    {
      "id": "workbench",
      "path": "web/ui.js",
      "responsibility": "页面状态、样例归约、视图切换与图形编排"
    },
    {
      "id": "reconcile",
      "path": "levelreplay/reconcile.py",
      "responsibility": "联合原始归约事实与业务判定，推导循环核差"
    },
    {
      "id": "segments",
      "path": "levelreplay/segments.py",
      "responsibility": "复核证据归约"
    },
    {
      "id": "review",
      "path": "levelreplay/review.py",
      "responsibility": "编排按领域事实驱动的可选复核"
    },
    {
      "id": "quality",
      "path": "levelreplay/quality.py",
      "responsibility": "复核证据归约"
    },
    {
      "id": "water_levels",
      "path": "levelreplay/water_levels.py",
      "responsibility": "测站标尺与有时距上限的水位插值"
    },
    {
      "id": "leakage",
      "path": "levelreplay/leakage.py",
      "responsibility": "闸室失水离线诊断：门位时序、停供时段与滚动水量窗"
    },
    {
      "id": "gate_sequence",
      "path": "levelreplay/gate_sequence.py",
      "responsibility": "门位动作序列识别及残缺序列收集"
    },
    {
      "id": "volume_curve",
      "path": "levelreplay/volume_curve.py",
      "responsibility": "分段截面积积分计算闸室体积"
    },
    {
      "id": "result_table",
      "path": "web/result-table.js",
      "responsibility": "结果表及结构化证据明细"
    },
    {
      "id": "version_panel",
      "path": "web/version-panel.js",
      "responsibility": "封存选择、版本读取、比对和下载"
    }
  ],
  "workflows": [
    {
      "id": "level",
      "name": "水尺归一",
      "entry": "POST /levelreplay/api/evaluate 的 outputs.level",
      "steps": [
        "高程绑定各测站零点",
        "下尺-10 的 高程 为 10.02"
      ],
      "success": "下尺-10 的 高程 为 10.02",
      "failure": "非法领域数据返回 400；不产生伪造结果",
      "verification": "python3 -m levelreplay.check_flow level",
      "module_ids": [
        "server",
        "contract",
        "service",
        "domain",
        "rules",
        "artifacts",
        "result_table",
        "water_levels"
      ]
    },
    {
      "id": "gate",
      "name": "门位重建",
      "entry": "POST /levelreplay/api/evaluate 的 outputs.gate",
      "steps": [
        "错序门位不得生成可信过闸循环",
        "续次下门关 的 状态 为 \"lower-close\""
      ],
      "success": "续次下门关 的 状态 为 \"lower-close\"",
      "failure": "非法领域数据返回 400；不产生伪造结果",
      "verification": "python3 -m levelreplay.check_flow gate",
      "module_ids": [
        "server",
        "contract",
        "service",
        "domain",
        "rules",
        "artifacts",
        "result_table",
        "gate_sequence"
      ]
    },
    {
      "id": "edge",
      "name": "水位边界",
      "entry": "POST /levelreplay/api/evaluate 的 outputs.edge",
      "steps": [
        "同站内可插值，跨采样空档不能补齐",
        "上门开 的 状态 为 \"known\""
      ],
      "success": "上门开 的 状态 为 \"known\"",
      "failure": "非法领域数据返回 400；不产生伪造结果",
      "verification": "python3 -m levelreplay.check_flow edge",
      "module_ids": [
        "server",
        "contract",
        "service",
        "domain",
        "rules",
        "artifacts",
        "result_table",
        "water_levels"
      ]
    },
